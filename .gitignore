# ============================================================
# dotfiles 忽略规则
# 只忽略「运行时生成 / 机器本地 / 私人数据」的文件，
# 不要在这里忽略真正的配置源文件。
# ============================================================

# --- Desktop shells ---
# DMS 自动生成的主题、版本标记和下载的插件；保留 settings.json / clsettings.json。
.config/DankMaterialShell/.config/DankMaterialShell/*.css
.config/DankMaterialShell/.config/DankMaterialShell/.changelog-*
.config/DankMaterialShell/.config/DankMaterialShell/.firstlaunch
.config/DankMaterialShell/.config/DankMaterialShell/plugins/

# --- zsh ---
# 补全缓存，与 zsh 版本和本机已装命令相关
.config/zsh/.config/zsh/.zcompdump
.config/zsh/.config/zsh/.zcompdump-*
# 命令历史，私人内容
.config/zsh/.config/zsh/.zsh_history
.config/zsh/.config/zsh/.zsh_history.*

# --- clipse ---
# 剪贴板历史，含私人内容（网址、IP、口令等）
.config/clipse/.config/clipse/clipboard_history.json

# --- fcitx5 ---
# 配置写入时的原子临时文件
.config/fcitx5/.config/fcitx5/profile_*

# --- 手工备份文件 ---
*.before-static-colors
*.bak
*~

# 已归档的旧配置副本
.config/nvim.pre-current-backup-20260712-1115/
.config/waybar-niri-Win11Like/.config/waybar-niri-Win11Like/style.css.backup

# Fcitx5 自动缓存与个人学习数据（单独私人备份）
.config/fcitx5/.config/fcitx5/conf/cached_layouts
.local/local/.local/share/fcitx5/pinyin/user.dict
.local/local/.local/share/fcitx5/pinyin/user.history

# 图标索引缓存与文件管理器窗口状态
.local/local/.local/share/icons/breeze_cursors/icon-theme.cache
.config/xfce4/.config/xfce4/xfconf/xfce-perchannel-xml/thunar.xml
